float hifbm(vec2 p) {
  const float aa = 0.5;
  const float pp = 2.0-0.;

  float sum = 0.0;
  float a   = 1.0;

  for (int i = 0; i < MOUNTAIN_DETAIL; ++i) {
    sum += a*vnoise(p);
    a *= aa;
    p *= pp;
  }

  return sum;
}

float lofbm(vec2 p) {
  const float aa = 0.5;
  const float pp = 2.0-0.;

  float sum = 0.0;
  float a   = 1.0;

  for (int i = 0; i < 2; ++i) {
    sum += a*vnoise(p);
    a *= aa;
    p *= pp;
  }

  return sum;
}

float hiheight(vec2 p) {
  return hifbm(p)*MOUNTAIN_HEIGHT-1.8;
}

float loheight(vec2 p) {
  return lofbm(p)*MOUNTAIN_HEIGHT-2.15;
}

vec4 plane(vec3 ro, vec3 rd, vec3 pp, vec3 npp, vec3 off, float n) {
  float h = hash(n);
  float s = mix(0.05, 0.25, h);

  vec3 hn;
  vec2 p = (pp-off*2.0*vec3(1.0, 1.0, 0.0)).xy;

  const vec2 stp = vec2(0.5, 0.33)*ROUGHNESS;
  float he    = hiheight(vec2(p.x, pp.z)*stp);
  float lohe  = loheight(vec2(p.x, pp.z)*stp);

  float d = p.y-he;
  float lod = p.y - lohe;

  float aa = distance(pp, npp)*sqrt(1.0/3.0);
  float t = smoothstep(aa, -aa, d);

  float df = exp(-0.1*(distance(ro, pp)-2.));
  vec3 acol = hsv2rgb(vec3(mix(FAR_HUE, NEAR_HUE, df), 0.9, mix(1.0, 0.0, df)));
  vec3 gcol = tanh_approx(exp(-mix(2.0, 8.0, df)*lod))*vec3(RIDGE_R, RIDGE_G, RIDGE_B);

  vec3 col = 0.0*unit3;
  col += acol;
  col += RIDGE_GLOW*gcol;

  return vec4(col, t);
}

vec3 stars(vec2 sp, float hh) {
  const vec3 scol0 = vec3(STAR_1_R, STAR_1_G, STAR_1_B);
  const vec3 scol1 = vec3(STAR_2_R, STAR_2_G, STAR_2_B);
  vec3 col = 0.0*unit3;

  const float m = float(STAR_LAYERS);

  for (float i = 0.0; i < m; ++i) {
    vec2 pp = sp+0.5*i;
    float s = i/(m-1.0);
    vec2 dim  = unit2*(mix(0.05, 0.003, s)*PI);
    vec2 np = mod2(pp, dim);
    vec2 h = hash2(np+127.0+i);
    vec2 o = -1.0+2.0*h;
    float y = sin(sp.x);
    pp += o*dim*0.5;
    pp.y *= y;
    float l = length(pp);

    float h1 = fract(h.x*1667.0);
    float h2 = fract(h.x*1887.0);
    float h3 = fract(h.x*2997.0);

    vec3 scol = mix(8.0*h2, 0.25*h2*h2, s)*mix(scol0, scol1, h1*h1);

    vec3 ccol = col + exp(-(mix(6000.0, 2000.0, hh)/mix(2.0, 0.25, s))*max(l-0.001, 0.0))*scol;
    ccol *= mix(0.125, 1.0, smoothstep(1.0, 0.99, sin(TWINKLE*TIME+TAU*h.y)));
    col = h3 < y ? ccol : col;
  }

  return col;
}

vec3 toSpherical(vec3 p) {
  float r   = length(p);
  float t   = acos(p.z/r);
  float ph  = atan2(p.y, p.x);
  return vec3(r, t, ph);
}

