    float m = 0.5+0.25*(sin(3.0*pp.x+TIME*2.1*PULSE_SPEED)+sin(3.3*pp.y+TIME*2.0*PULSE_SPEED));
    m *= m;
    m *= m;
    pp = fract(pp+0.5)-0.5;
    float dp = pmin(abs(pp.x), abs(pp.y), 0.125);
    dp = min(dp, db);
    vec3 hsv = vec3(FLOOR_HUE+mix(PULSE_HUE,0.0, m), tanh_approx(mix(50.0, 10.0, m)*dp), 1.0);
