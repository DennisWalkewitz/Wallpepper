  float tp1  = rayPlane(ro, rd, vec4(vec3(0.0, -1.0, 0.0), 6.0));

  float tp = tp1;
  tp = max(tp0,tp1);
  if (tp > 0.0) {
    vec3 pos  = ro + tp*rd;
    vec3 tpos = pos+vec3(0.0, 0.0, 2.0*TIME*FLOOR_SPEED);
    const float fz = GRID_SCALE;
