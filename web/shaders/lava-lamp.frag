#define BLOB_COUNT 9          // number of wax blobs (2..14)
#define BLOB_SIZE 1.0         // blob size
#define RISE_SPEED 1.0        // how fast blobs travel
#define STICKINESS 1.0        // how readily blobs merge
#define WOBBLE 1.0            // sideways drift
