    col *= EXPOSURE;
    col = saturate(col * (2.51 * col + 0.03) / (col * (2.43 * col + 0.59) + 0.14));
    col = pow(col, float3(0.4545, 0.4545, 0.4545));
    float2 vc = tex - 0.5;
    col *= 1.0 - dot(vc, vc) * 0.45;

    float4 fg = texture(shaderTexture, tex);
    float2 o = 2.0 * Scale / Resolution;
    float cover = max(fg.a, max(texture(shaderTexture, tex + o).a, texture(shaderTexture, tex - o).a));
    col *= 1.0 - TEXT_VEIL * cover;
    col = col * (1.0 - fg.a) + fg.rgb;
    col += (hash12(tex * Resolution) - 0.5) / 255.0;
    return float4(saturate(col), 1.0);
}

void main() {
    vec2 p = vec2(WallpepperOrigin.x + gl_FragCoord.x, WallpepperOrigin.y - gl_FragCoord.y);
    fragColor = ps_entry(vec4(p, 0.0, 1.0), p / Resolution);
}
