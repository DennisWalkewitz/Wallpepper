#define SPIN_XZ 0.030         // ordinary turning, like a carousel (0..0.4)
#define DEPTH_5D 1.9          // distance of the eye in the fifth dimension (1.4..5, near = strong perspective, far = nearly flat)
#define DEPTH_4D 1.9          // distance of the eye in the fourth dimension (1.4..5, near = strong perspective, far = nearly flat)
