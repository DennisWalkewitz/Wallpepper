    float2 k3 = float2(cos(t * SPIN_ZV + 0.25), sin(t * SPIN_ZV + 0.25));
    float2 k4 = float2(cos(t * SPIN_XW + 0.60), sin(t * SPIN_XW + 0.60));
    float2 k5 = float2(cos(t * SPIN_WV + 0.15), sin(t * SPIN_WV + 0.15));
    float2 k6 = float2(cos(t * SPIN_XZ + 0.50), sin(t * SPIN_XZ + 0.50));
    float4 c0 = float4(1.0, 0.0, 0.0, 0.0), c1 = float4(0.0, 1.0, 0.0, 0.0), c2 = float4(0.0, 0.0, 1.0, 0.0);
    float4 c3 = float4(0.0, 0.0, 0.0, 1.0), c4 = float4(0.0, 0.0, 0.0, 0.0);
    float v0 = 0.0, v1 = 0.0, v2 = 0.0, v3 = 0.0, v4 = 1.0;
    float2 r2;
    r2 = turn(float2(c0.x, v0), k1); c0.x = r2.x; v0 = r2.y;   r2 = turn(float2(c1.x, v1), k1); c1.x = r2.x; v1 = r2.y;
    r2 = turn(float2(c2.x, v2), k1); c2.x = r2.x; v2 = r2.y;   r2 = turn(float2(c3.x, v3), k1); c3.x = r2.x; v3 = r2.y;
    r2 = turn(float2(c4.x, v4), k1); c4.x = r2.x; v4 = r2.y;
    c0.yw = turn(c0.yw, k2); c1.yw = turn(c1.yw, k2); c2.yw = turn(c2.yw, k2); c3.yw = turn(c3.yw, k2); c4.yw = turn(c4.yw, k2);
    r2 = turn(float2(c0.z, v0), k3); c0.z = r2.x; v0 = r2.y;   r2 = turn(float2(c1.z, v1), k3); c1.z = r2.x; v1 = r2.y;
    r2 = turn(float2(c2.z, v2), k3); c2.z = r2.x; v2 = r2.y;   r2 = turn(float2(c3.z, v3), k3); c3.z = r2.x; v3 = r2.y;
    r2 = turn(float2(c4.z, v4), k3); c4.z = r2.x; v4 = r2.y;
    c0.xw = turn(c0.xw, k4); c1.xw = turn(c1.xw, k4); c2.xw = turn(c2.xw, k4); c3.xw = turn(c3.xw, k4); c4.xw = turn(c4.xw, k4);
    r2 = turn(float2(c0.w, v0), k5); c0.w = r2.x; v0 = r2.y;   r2 = turn(float2(c1.w, v1), k5); c1.w = r2.x; v1 = r2.y;
    r2 = turn(float2(c2.w, v2), k5); c2.w = r2.x; v2 = r2.y;   r2 = turn(float2(c3.w, v3), k5); c3.w = r2.x; v3 = r2.y;
    r2 = turn(float2(c4.w, v4), k5); c4.w = r2.x; v4 = r2.y;
    c0.xz = turn(c0.xz, k6); c1.xz = turn(c1.xz, k6); c2.xz = turn(c2.xz, k6); c3.xz = turn(c3.xz, k6); c4.xz = turn(c4.xz, k6);

    float swell = 1.0 + 0.045 * clamp(BREATHE, 0.0, 3.0) * sin(t * 0.45);
    float px = 1.0 / (1.9 * Resolution.y);
    float3 sxv = normalize(rt * 0.940 + upv * 0.342), syv = normalize(upv * 0.940 - rt * 0.342);   // tilted axes for the sparkles

    float3 col = float3(0.0, 0.0, 0.0);
