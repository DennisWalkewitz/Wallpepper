float hash12(float2 p)
{
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float2 turn(float2 v, float2 cs) { return float2(cs.x * v.x - cs.y * v.y, cs.y * v.x + cs.x * v.y); }

// ---- five dimensions ------------------------------------------------------------------------------------
// A 5D point is kept as a float4 (x, y, z, w) plus one more number (v).
float depth5() { return 2.236 * max(DEPTH_5D, 1.15); }
float reach4() { float k = max(DEPTH_5D, 1.15); return 2.236 * k / sqrt(k * k - 1.0); }                // biggest size after 5D -> 4D
float depth4() { return reach4() * max(DEPTH_4D, 1.15); }
float reach3() { float k = max(DEPTH_4D, 1.15); return reach4() * k / sqrt(k * k - 1.0); }             // biggest size after 4D -> 3D
float boundRadius() { return 1.12 * FIGURE_SIZE; }
float tubeSize() { return max(TUBE_SIZE, 0.001); }

// perspective from five dimensions into four, then from four into three.
// xyz = where the point ends up, w = how thick things are there (nearer in 4D/5D = bigger, evened out a little)
float4 project5(float4 p, float pv, float swell)
{
    float f = depth5() * depth4() / (depth4() * (depth5() - pv) - p.w * depth5());    // both perspectives in one division
    return float4(p.xyz * (f * swell * boundRadius() / reach3()), min(f, min(0.55 + 0.45 * f, 1.25 + 0.10 * f)));
}

float3 axisColour(float a)
{
    float3 c = float3(AXIS1_R, AXIS1_G, AXIS1_B) * saturate(1.0 - abs(a));
    c += float3(AXIS2_R, AXIS2_G, AXIS2_B) * saturate(1.0 - abs(a - 1.0));
    c += float3(AXIS3_R, AXIS3_G, AXIS3_B) * saturate(1.0 - abs(a - 2.0));
    c += float3(AXIS4_R, AXIS4_G, AXIS4_B) * saturate(1.0 - abs(a - 3.0));
    c += float3(AXIS5_R, AXIS5_G, AXIS5_B) * saturate(1.0 - abs(a - 4.0));
    return c * c;                                             // picked colour -> amount of light
}

float3 averageColour()
{
    return (axisColour(0.0) + axisColour(1.0) + axisColour(2.0) + axisColour(3.0) + axisColour(4.0)) * 0.2;
}

// One corner: a small bright ball with a halo and, for the nearest corners, a four-pointed sparkle.
// off = from the corner to the nearest spot on the ray, rn = radius of the ball, thick = how near it is in 4D/5D
float cornerLight(float3 off, float rn, float edge, float thick, float3 sx, float3 sy)
{
    float d = length(off);
    float c = smoothstep(rn + edge, rn * 0.4, d) + 0.10 * GLOW / (1.0 + d * d / (rn * rn * 6.0));
    float2 sp = float2(dot(off, sx), dot(off, sy)) / rn;
    float star = exp(-abs(sp.x) * 0.22 - sp.y * sp.y * 9.0) + exp(-abs(sp.y) * 0.22 - sp.x * sp.x * 9.0);
    return c + star * 0.012 * thick * thick * thick * thick * SPARKLE;
}

// All the light of the figure along one ray: 80 tubes and 32 corner points. Light simply adds up, so nothing
// has to be sorted. For each tube the ray's closest approach gives the bright tube itself and the halo around it.
// sx, sy = the two directions the sparkles point in; tmax = how far the ray goes; blur = extra softness per unit of distance (for the reflection in the floor);
// halo = how far outside the figure the halo is still drawn;
// path = distance the light has already travelled before ro (far tubes are dimmed a little by the mist);
// px = size of a pixel per unit of distance (for smooth edges); beat = where the brightness wave is right now.
float3 tubeLight(float3 ro, float3 rd, float3 sx, float3 sy, float tmax, float blur, float path, float halo,
                 float px, float swell, float beat, float4 c0, float4 c1, float4 c2, float4 c3, float4 c4, float v0, float v1, float v2, float v3, float v4)
{
    float3 acc = float3(0.0, 0.0, 0.0);
    float reach = boundRadius() * swell * 1.02 + halo * GLOW_RADIUS * FIGURE_SIZE;
    float bq = dot(ro, rd);
    float3 nearest = ro - rd * clamp(bq, -tmax, 0.0);
    float miss = dot(nearest, nearest);
    float gr = 0.060 * max(GLOW_RADIUS, 0.05) * FIGURE_SIZE;
    float nearT = CAMERA_DISTANCE - boundRadius();
    float4 e = c0, u = c1, v = c2, w = c3, q = c4;
    float es = v0, us = v1, vs = v2, ws = v3, qs = v4;
    if (miss < reach * reach)                                     // nothing to do for rays that pass far away
    {
         for (int a = 0; a < 5; a++)
        {
            float3 tint = axisColour(float(a));
            float3 hot = lerp(tint, float3(1.0, 1.0, 1.0), 0.5);
             for (int j = 0; j < 16; j++)                           // the 16 tubes that run in this direction
            {
                float4 sg = step(0.5, frac(float(j) * float4(0.5, 0.25, 0.125, 0.0625))) * 2.0 - 1.0;
                float4 p5 = u * sg.x + v * sg.y + w * sg.z + q * sg.w - e;
                float pv = us * sg.x + vs * sg.y + ws * sg.z + qs * sg.w - es;
                float4 pa = project5(p5, pv, swell);
                float4 pb = project5(p5 + 2.0 * e, pv + 2.0 * es, swell);
                float3 ba = pb.xyz - pa.xyz;
                float3 oa = ro - pa.xyz;
                float baba = dot(ba, ba), bad = dot(ba, rd), baoa = dot(ba, oa), doa = dot(rd, oa);
                float s = saturate((baoa - bad * doa) / max(baba - bad * bad, 0.000001));
                float tt = clamp(bad * s - doa, 0.0, tmax);
                s = saturate((baoa + bad * tt) / max(baba, 0.000001));
                float3 dv = oa + rd * tt - ba * s;
                float dist = length(dv);
                float thick = lerp(pa.w, pb.w, s);
                float soft = blur * tt;
                float r = tubeSize() * thick + soft;
                float hg = gr * (0.55 + 0.45 * thick) + soft * 2.0;
                if (dist < r + hg * 5.0)                                          // close enough to add visible light
                {
                    float dim = tubeSize() * thick / r * exp(-max(path + tt - nearT, 0.0) * 0.20 * HAZE);   // blurred or far = dimmer
                    dim *= 1.0 + 0.40 * clamp(PULSE, 0.0, 1.5) * sin(beat - 1.9 * (pv + 2.0 * es * s));      // the wave passing by
                    float edge = max(r * 0.14, 1.1 * px * tt);
                    float x = dist / r;
                    float body = smoothstep(r + edge, r - edge, dist);
                    float inner = saturate(1.0 - x * x);
                    float3 c = lerp(tint * 1.7, hot * 2.0, inner * inner * inner * 0.60 * saturate(WHITE_CORE)) * body;
                    float g1 = 1.0 / (1.0 + dist * dist / (r * r * 9.0));           // tight glow hugging the tube
                    float g2 = 1.0 / (1.0 + dist * dist / (hg * hg)) - 0.0385;      // wide halo (fades to nothing at 5 radii)
                    acc += (c * TUBE_LIGHT + tint * (g1 * g1 * 0.45 + g2 * g2 * 0.10 * thick) * GLOW) * dim;
                }

                if (a == 0)                                                       // these 16 tubes end in all 32 corners
                {
                    float ta = clamp(-doa, 0.0, tmax);
                    float rn = tubeSize() * pa.w * 1.7 + blur * ta;
                    float na = cornerLight(oa + rd * ta, rn, max(rn * 0.3, 1.5 * px * ta), pa.w, sx, sy) * tubeSize() * pa.w / rn;
                    float3 ob = ro - pb.xyz;
                    float tb = clamp(-dot(ob, rd), 0.0, tmax);
                    float rm = tubeSize() * pb.w * 1.7 + blur * tb;
                    float nb = cornerLight(ob + rd * tb, rm, max(rm * 0.3, 1.5 * px * tb), pb.w, sx, sy) * tubeSize() * pb.w / rm;
                    acc += float3(1.0, 0.96, 0.90) * (na + nb) * NODE_LIGHT;
                }
            }
            float4 tmp = e; e = u; u = v; v = w; w = q; q = tmp;
            float tms = es; es = us; us = vs; vs = ws; ws = qs; qs = tms;
        }
    }
    return acc * smoothstep(reach * reach, reach * reach * 0.55, miss);
}

float3 backdrop(float3 rd, float3 fw)
{
    float3 bg = float3(BACKDROP_R, BACKDROP_G, BACKDROP_B);
    float3 c = bg * (0.30 + 0.45 * smoothstep(-0.35, 0.06, rd.y) - 0.45 * smoothstep(0.06, 0.55, rd.y));
    c += bg * 0.7 * exp(-16.0 * (rd.y - 0.02) * (rd.y - 0.02));   // soft band of light where the wall meets the floor
    float3 hd = normalize(float3(fw.x, 0.08, fw.z));
    c += (bg * 0.9 + averageColour() * 0.012 * HAZE) * pow(saturate(dot(rd, hd)), 22.0);    // the mist behind the figure glows a little
    return c;
}

float3 render(float3 ro, float3 rd, float3 fw, float3 sx, float3 sy, float px, float swell, float beat,
              float4 c0, float4 c1, float4 c2, float4 c3, float4 c4, float v0, float v1, float v2, float v3, float v4)
{
    float floorY = -1.10 * FIGURE_SIZE;
    float3 col = backdrop(rd, fw);
    float tmax = 1000000.0;

    if (rd.y < -0.001)
    {
        // dark glossy floor: a pool of coloured light under the figure and its blurred mirror image
        float tf = (floorY - ro.y) / rd.y;
        float3 pf = ro + rd * tf;
        tmax = tf;
        float3 avg = averageColour();
        float d2 = dot(pf.xz, pf.xz) / (FIGURE_SIZE * FIGURE_SIZE);
        float3 fcol = float3(0.004, 0.004, 0.007) + avg * (0.050 / (1.0 + d2 * 1.6) + 0.012 * exp(-d2 * 0.25)) * TUBE_LIGHT;

        float3 rr = float3(rd.x, -rd.y, rd.z);
        float fres = 0.06 + 0.94 * pow(1.0 - saturate(-rd.y), 5.0);
        float3 refl = backdrop(rr, fw) * 0.6;
        if (FLOOR_REFLECTION > 0.001)
        {
            refl += tubeLight(pf, rr, sx, float3(sy.x, -sy.y, sy.z), 1000000.0, 0.006 * FLOOR_BLUR, tf, 0.12,
                              px, swell, beat, c0, c1, c2, c3, c4, v0, v1, v2, v3, v4);
        }
        fcol += refl * fres * 1.8 * FLOOR_REFLECTION;

        float fog = saturate(1.0 - exp(-tf * tf * 0.005));
        col = lerp(fcol, col, fog);
    }
    col += tubeLight(ro, rd, sx, sy, tmax, 0.0, 0.0, 0.28, px, swell, beat, c0, c1, c2, c3, c4, v0, v1, v2, v3, v4);
    return col;
}

float4 ps_entry(float4 pos  , float2 tex  )  
{
