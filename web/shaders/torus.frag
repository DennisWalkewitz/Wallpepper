  col = aces_approx(col);
  col *= smoothstep(0.0, max(SCENE_FADE*SPEED, 0.0001), ptime);   // the fade lasts SCENE_FADE real seconds at any SPEED
  col *= smoothstep(PERIOD, PERIOD-max(SCENE_FADE*SPEED, 0.0001), ptime);
