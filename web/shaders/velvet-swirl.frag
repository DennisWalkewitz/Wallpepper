// ---- colours (0..1 each) ----
#define COLOUR_1_R 0.560      // main paint colour: red
#define COLOUR_1_G 0.090      // main paint colour: green
#define COLOUR_1_B 0.360      // main paint colour: blue
#define COLOUR_2_R 0.960      // second paint colour: red
#define COLOUR_2_G 0.620      // second paint colour: green
#define COLOUR_2_B 0.180      // second paint colour: blue
#define COLOUR_3_R 0.070      // dark gaps: red
#define COLOUR_3_G 0.035      // dark gaps: green
#define COLOUR_3_B 0.110      // dark gaps: blue
#define HUE_SHIFT 0.0         // rotate all colours around the colour wheel (0..1)
#define HUE_CYCLE 0.0         // hue rotations per minute (0 = fixed colours)
#define SATURATION 1.0        // 0 = grey, 1 = original, 2 = vivid
#define BRIGHTNESS 0.85       // overall brightness
// ---- motion and shape ----
#define SPIN_ROTATION 1.2     // rotation speed and direction of the whole swirl
#define ROTATE 1              // 1 = the swirl rotates, 0 = stands still
#define SPIN_SPEED 4.5        // speed of the paint flow
#define SPIN_AMOUNT 0.30      // how tightly the centre is twisted
#define SPIN_EASE 1.0         // twist falloff
#define CONTRAST 2.6          // paint contrast
#define LIGHTING 0.55         // glossy highlights
#define ZOOM 1.9              // lower = smaller pattern
#define DETAIL 6              // paint layers (1..8)
#define PIXEL_FILTER 2400.0   // pixelation: lower = chunkier pixels, higher = smooth
#define CENTER_X 0.42         // swirl centre, 0..1 of width
#define CENTER_Y 0.55         // swirl centre, 0..1 of height
#define TEXT_VEIL 0.4         // darkening behind terminal text

float3 hueRotate(float3 c, float turns)
{
    float a = turns * 6.2831853;
    float3 k = float3(0.57735, 0.57735, 0.57735);
    float ca = cos(a), sa = sin(a);
    return c * ca + cross(k, c) * sa + k * dot(k, c) * (1.0 - ca);
}

float3 grade(float3 c)
{
    c = hueRotate(c, HUE_SHIFT + HUE_CYCLE * Time / 60.0);
    float l = dot(c, float3(0.299, 0.587, 0.114));
    return lerp(float3(l, l, l), c, SATURATION);
}

float3 effect(float2 resolution, float2 screen_coords)
{
    float pixel_size = length(resolution) / PIXEL_FILTER;
    float2 centre = float2(CENTER_X, CENTER_Y) * resolution;
    float2 uv = (floor(screen_coords / pixel_size) * pixel_size - centre) / resolution.y;
    uv /= ZOOM;
    float uv_len = length(uv);

    float speed = SPIN_ROTATION * SPIN_EASE * 0.2;
    if (ROTATE > 0) speed = Time * speed;
    speed += 302.2;
    float ang = atan2(uv.y, uv.x) + speed - SPIN_EASE * 20.0 * (SPIN_AMOUNT * uv_len + (1.0 - SPIN_AMOUNT));
    uv = float2(uv_len * cos(ang), uv_len * sin(ang));

    uv *= 30.0;
    speed = Time * SPIN_SPEED;
    float2 uv2 = uv;
    for (int i = 0; i < DETAIL; i++)
    {
        uv2 += sin(max(uv.x, uv.y)) + uv;
        uv += 0.5 * float2(cos(5.1123314 + 0.353 * uv2.y + speed * 0.131121), sin(uv2.x - 0.113 * speed));
        uv -= cos(uv.x + uv.y) - sin(uv.x * 0.711 - uv.y);
    }

    float contrast_mod = 0.25 * CONTRAST + 0.5 * SPIN_AMOUNT + 1.2;
    float paint_res = min(2.0, max(0.0, length(uv) * 0.035 * contrast_mod));
    float c1p = max(0.0, 1.0 - contrast_mod * abs(1.0 - paint_res));
    float c2p = max(0.0, 1.0 - contrast_mod * abs(paint_res));
    float c3p = 1.0 - min(1.0, c1p + c2p);
    float light = (LIGHTING - 0.2) * max(c1p * 5.0 - 4.0, 0.0) + LIGHTING * max(c2p * 5.0 - 4.0, 0.0);
    float3 col1 = grade(float3(COLOUR_1_R, COLOUR_1_G, COLOUR_1_B));
    float3 col2 = grade(float3(COLOUR_2_R, COLOUR_2_G, COLOUR_2_B));
    float3 col3 = grade(float3(COLOUR_3_R, COLOUR_3_G, COLOUR_3_B));
    return (0.3 / CONTRAST) * col1 + (1.0 - 0.3 / CONTRAST) * (col1 * c1p + col2 * c2p + col3 * c3p) + light;
}

float4 ps_entry(float4 pos  , float2 tex  )  
{
    float3 col = effect(Resolution, tex * Resolution) * BRIGHTNESS;
    float4 fg = texture(shaderTexture, tex);
    col *= 1.0 - TEXT_VEIL * fg.a;
    col = col * (1.0 - fg.a) + fg.rgb;
    return float4(saturate(col), 1.0);
}

