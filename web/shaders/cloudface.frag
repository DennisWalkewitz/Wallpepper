#if defined(WINDOWS_TERMINAL)
float4 ps_entry(float4 pos  , float2 tex  )  
#else
float4 ps_main(float4 pos  , float2 tex  )  
#endif
{
  vec2 q = tex;
  vec2 p = -1.0 + 2.0*q;
#if defined(WINDOWS_TERMINAL)
  p.y = -p.y;
#endif
  p.x *= RESOLUTION.x/RESOLUTION.y;
  p = finishView(p);

  vec3 col = smear(p, q);
  col = aces_approx(col);
  col = sRGB(col);
  col = finishGrade(col, q);

  vec4 fg = texture(shaderTexture, q);
  vec4 sh = texture(shaderTexture, q-2.0*unit2/RESOLUTION.xy);
  float2 veilStep = 2.0 * Scale / Resolution;
  float cover = max(fg.w, max(texture(shaderTexture, q + veilStep).w, texture(shaderTexture, q - veilStep).w));
  col *= 1.0 - TEXT_VEIL * cover;                       // darken behind text so it stays readable
  col = mix(col, 0.0*unit3, sh.w*TEXT_SHADOW);
  col = mix(col, fg.xyz, fg.w);
  col += (ditherHash12(q * Resolution) - 0.5) / 255.0;    // dither: hides banding in dark gradients
  return vec4(col, 1.0);
}




