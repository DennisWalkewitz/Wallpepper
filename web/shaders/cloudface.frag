float pmin(float a, float b, float k) {
  float h = clamp(0.5+0.5*(b-a)/k, 0.0, 1.0);
  return mix(b, a, h) - k*h*(1.0-h);
}

float vesica(vec2 p, vec2 sz) {
  if (sz.x < sz.y) {
    sz = sz.yx;
  } else {
    p  = p.yx;
  }
  vec2 sz2 = sz*sz;
  float d  = (sz2.x-sz2.y)/(2.0*sz.y);
  float r  = sqrt(sz2.x+d*d);
  float b  = sz.x;
  p = abs(p);
  return ((p.y-b)*d>p.x*b) ? length(p-vec2(0.0,b))
                           : length(p-vec2(-d,0.0))-r;
}

float pabs(float a, float k) {
  return -pmin(a, -a, k);
}

float noise(vec2 p) {
  float a = sin(p.x);
  float b = sin(p.y);
  float c = 0.5 + 0.5*cos(p.x + p.y);
  float d = mix(a, b, c);
  return d;
}

float fbm(vec2 p) {
  float f = 0.0;
  float a = 1.0;
  float s = 0.0;
  float m = 2.0;
  for (int x = 0; x < CLOUD_DETAIL; ++x) {
    f += a*noise(p); p = mul(frot, p);
    m += 0.01;
    s += a;
    a *= 0.5;
  }
  return f/s;
}

vec2 df(vec2 p) {
  vec2 p0 = p;
  p0.x = abs(p0.x);
  p0 -= vec2(EYE_SPACING, EYE_HEIGHT);
  p0 = mul(ROT(PI/9.0), p0);
  float d0 = vesica(p0, vec2(EYE_WIDTH, EYE_OPENING));
  float g0 = length(p0);

  float d = d0;
  float g = g0;

  return vec2(d, g);
}

float warp(vec2 p, inout State state, out vec2 v, out vec2 w) {
  float d = df(p).x-0.1;
  if (FACE > 0) p.x = -pabs(p.x, 0.125);

  v = vec2(fbm(p + state._vx), fbm(p + state._vy));
  w = vec2(fbm(p + SMEAR*v + state._wx), fbm(p + SMEAR*v + state._wy));

  float h = fbm(p + SWIRL*w);

  float aa = 0.2;
  if (EYES > 0) h *= mix(1.0, 0.05, smoothstep(aa, -aa, d));

  return h*smoothstep(2.5, 0.15, abs(p.x+0.5*p.y));
}

vec3 normal(vec2 p, inout State state) {
  vec2 v;
  vec2 w;
  float eps = 2.0/RESOLUTION.y;
  vec2 e = vec2(eps, 0);

  vec3 n;
  n.x = warp(p + e.xy, state, v, w) - warp(p - e.xy, state, v, w);
  n.y = 2.0*e.x;
  n.z = warp(p + e.yx, state, v, w) - warp(p - e.yx, state, v, w);

  return normalize(n);
}

vec3 smear(vec2 p, vec2 q) {
  float aa = 2.0/RESOLUTION.y;

  State state;
//  state._vx = mul(vec2(0.0, 0.0), ROT(TTIME/1000.0));
  state._vx = unit2*0.0;
  state._vy = mul(vec2(3.2, 1.3), ROT(CLOUD_SPEED*TTIME/900.0));
  state._wx = mul(vec2(1.7, 9.2), ROT(CLOUD_SPEED*TTIME/800.0));
  state._wy = mul(vec2(8.3, 2.8), ROT(CLOUD_SPEED*TTIME/700.0));

  vec2 v;
  vec2 w;

  vec2 d2 = df(p);
  float d = abs(d2.x) - 2.0*aa;
  float g = d2.y;
  float h = warp(p, state, v, w);
  vec3 n  = normal(p, state);

  vec3 ld1  = normalize(vec3(0.5, 0.2, 0.4));
  vec3 ld2  = normalize(vec3(-0.5, 0.2, -0.4));
  vec3 lcol1= vec3(LIGHT_1_R, LIGHT_1_G, LIGHT_1_B);
  vec3 lcol2= 2.0*vec3(LIGHT_2_R, LIGHT_2_G, LIGHT_2_B);
  vec3 acol = vec3(AMBIENT, AMBIENT, AMBIENT);

  float dif1 = pow(max(dot(ld1, n), .0), 1.0);
  float dif2 = pow(max(dot(ld2, n), .0), 2.0);

  const vec3 col11 = 0.5*vec3(COLOUR_LEFT_R, COLOUR_LEFT_G, COLOUR_LEFT_B);
  const vec3 col21 = 0.5*vec3(COLOUR_TOP_R, COLOUR_TOP_G, COLOUR_TOP_B);
  const vec3 col12 = 1.5*vec3(COLOUR_RIGHT_R, COLOUR_RIGHT_G, COLOUR_RIGHT_B);
  const vec3 col22 = 1.5*vec3(COLOUR_BOTTOM_R, COLOUR_BOTTOM_G, COLOUR_BOTTOM_B);

  vec3 col1 = mix(col11, col12, q.x);
  vec3 col2 = mix(col21, col22, q.y);

  vec3 col = unit3*(0.0);
  float lv = length(v);
  float lw = length(w);
  col += lv*col1*dif1*lcol1;
  col += lw*col2*dif1*lcol1;
  col += lv*col1*dif2*lcol2;
  col += lw*col2*dif2*lcol2;
  col += lv*col1*acol;
  col += lw*col2*acol;
  col *= smoothstep(0.0, 1., (h*h+0.05+0.75*0.125*(1.0+p.y)));
  if (EYES > 0) col += EYE_GLOW*mix(5.0, 1.0, 0.5+0.5*sin(EYE_PULSE*TTIME/8.0))*vec3(EYE_R, EYE_G, EYE_B)*exp(-40.0*g);
  col -= vec3(0.1, 0.2, 0.1)*0.25;
  return col;
}

