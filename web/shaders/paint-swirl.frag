        p += q * FOLD_STRENGTH * 1.25 / (0.6 + 0.4 * fi);
    }
    return sin(p.x * 0.9 + 0.6 * sin(p.y * 0.7 + ft)) * 0.6 + sin(p.y * 1.1 - 0.5 * cos(p.x * 0.6 - ft * 0.8)) * 0.4;
}

float4 ps_entry(float4 pos  , float2 tex  )  
{
