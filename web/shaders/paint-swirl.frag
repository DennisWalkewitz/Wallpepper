        st = (floor(tex * cells) + 0.5) / cells;
    }
    float2 uv = float2((st.x - CENTRE_X) * aspect, st.y - CENTRE_Y);

    float e = 0.004;
    float v = paint(uv, t);
    float2 grad = float2(paint(uv + float2(e, 0.0), t) - v, paint(uv + float2(0.0, e), t) - v) / e;

