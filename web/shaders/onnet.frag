vec2 transform(vec2 p, float i) {
  float tm = 1.25*(TIME*0.05);
  float ii = i/float(NOOFBCOLS);
  float f = sin(WAVES*p.y+2.1*i+WAVE_SPEED*tm);
  vec2 sp = toSmith(p);
//  sp.y -= 0.1*i+0.9*sin(+0.1*i);
  sp = mul(ROT(FAN*i+TURN_SPEED*tm), sp);
  sp = mul(ROT(mix(0.1, 0.2, ii)*f*WOBBLE), sp);
//  p.x += .08*f;
  p = fromSmith(sp);;
  return p;
}

float df(vec2 p, float i) {
  return plane(p, vec3(normalize(-vec2(1.0, 1.0)), BAND_SPACING*abs(i-0.0)-BAND_OFFSET));
}

vec3 effect(vec2 p, vec2 np) {
  const float off = -.35;
  p += off;
  np += off;
  float aaa = 2.0/RESOLUTION.y;
  vec3 col = bcols[0];

  for (int i = 1; i < BANDS; ++i) {
    float ii = float(i);
    vec2 pp   = transform(p, ii);
    vec2 npp  = transform(np, ii);
    float aa  = distance(pp, npp)*sqrt(0.5);
    float d = df(pp, ii);
    col = mix(col, col*SHADOW_DEPTH, exp(-max(SHADOW_SHARPNESS*d*aaa/aa, 0.0)));
    col = mix(col, bcols[i], smoothstep(aa, -aa, d));
  }


  return col;
}

